---
import { Image } from "astro:assets";

import PrimaryButton from "../Buttons/PrimaryButton.astro";

const { image, title, description } = Astro.props;
---

<div
  class="singleBlogCard flex flex-col border-4 border-dark drop-shadow-4xl bg-projectCardBg"
>
  <figure class="border-b-4 border-dark overflow-hidden">
    <Image
      class="w-full h-48 object-cover object-top"
      src={image}
      alt={title}
    />
  </figure>
  <div class="flex flex-col flex-1 gap-3 p-6">
    <h2 class="font-black text-2xl text-dark leading-tight">{title}</h2>
    <p class="font-lightFont text-base text-dark flex-1">
      {description}
    </p>
    <div class="flex justify-end">
      <PrimaryButton text="Read more" href="/blog" />
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const cards = document.querySelectorAll(".singleBlogCard");
  gsap.set(cards, { opacity: 0, y: 50 });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          gsap.to(entry.target, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: "back.out(1.4)",
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );

  cards.forEach((card) => observer.observe(card));
</script>
